{
  "name": "wrapperguard",
  "displayName": "WrapperGuard",
  "description": "Static wrapper and bootstrap security analysis for Gradle projects. Never executes project code.",
  "version": "0.3.0",
  "publisher": "sal7one",
  "repository": { "type": "git", "url": "https://github.com/sal7one/wrapperguard" },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Linters", "Programming Languages"],
  "activationEvents": ["onStartupFinished", "onView:wrapperGuard.main", "onCommand:wrapperGuard.scanWorkspace"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "wrapperGuard.scanWorkspace", "title": "WrapperGuard: Scan Workspace", "icon": "$(refresh)" },
      { "command": "wrapperGuard.exportReport", "title": "WrapperGuard: Export Report (JSON)", "icon": "$(export)" },
      { "command": "wrapperGuard.exportSarif", "title": "WrapperGuard: Export SARIF", "icon": "$(export)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "wrapperGuard", "title": "WrapperGuard", "icon": "resources/shield.svg" }
      ]
    },
    "views": {
      "wrapperGuard": [
        { "id": "wrapperGuard.main", "name": "WrapperGuard", "type": "webview" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "wrapperGuard.scanWorkspace", "when": "view == wrapperGuard.main", "group": "navigation@1" },
        { "command": "wrapperGuard.exportReport", "when": "view == wrapperGuard.main", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "WrapperGuard",
      "properties": {
        "wrapperGuard.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Run a scan automatically when a workspace folder is opened."
        },
        "wrapperGuard.allowedHosts": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional hosts allowed in URLs and repositories (merged with the built-in defaults)."
        },
        "wrapperGuard.blockedCommands": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional commands blocked in wrapper/script files (merged with the built-in defaults)."
        },
        "wrapperGuard.requireDistributionSha256": {
          "type": "boolean",
          "default": false,
          "description": "Require distributionSha256Sum in gradle-wrapper.properties."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "parity": "node scripts/parity.js",
    "hardening": "node scripts/hardening.js",
    "test": "npm run compile && node --test tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}
