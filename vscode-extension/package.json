{
  "name": "wrapperguard",
  "displayName": "WrapperGuard",
  "description": "Static wrapper and bootstrap security analysis for Gradle projects. Never executes project code.",
  "version": "0.2.0",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Linters", "Programming Languages"],
  "activationEvents": ["onStartupFinished", "onView:wrapperGuard.findings", "onCommand:wrapperGuard.scanWorkspace"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "wrapperGuard.scanWorkspace", "title": "WrapperGuard: Scan Workspace", "icon": "$(refresh)" },
      { "command": "wrapperGuard.exportReport", "title": "WrapperGuard: Export Report (JSON)", "icon": "$(export)" },
      { "command": "wrapperGuard.openFinding", "title": "WrapperGuard: Open in Editor", "icon": "$(go-to-file)" },
      { "command": "wrapperGuard.showFindingDetails", "title": "WrapperGuard: Show Finding Details" },
      { "command": "wrapperGuard.copyEvidence", "title": "WrapperGuard: Copy Evidence", "icon": "$(copy)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "wrapperGuard", "title": "WrapperGuard", "icon": "resources/shield.svg" }
      ]
    },
    "views": {
      "wrapperGuard": [
        { "id": "wrapperGuard.summary", "name": "Summary" },
        { "id": "wrapperGuard.findings", "name": "Findings" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wrapperGuard.findings",
        "contents": "No scan yet — wrappers, build files, and bootstrap scripts are unprotected until scanned.\n[Scan Workspace](command:wrapperGuard.scanWorkspace)"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "wrapperGuard.scanWorkspace", "when": "view == wrapperGuard.summary", "group": "navigation@1" },
        { "command": "wrapperGuard.exportReport", "when": "view == wrapperGuard.summary", "group": "navigation@2" },
        { "command": "wrapperGuard.scanWorkspace", "when": "view == wrapperGuard.findings", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "wrapperGuard.showFindingDetails", "when": "viewItem == wrapperGuardFinding", "group": "inline" },
        { "command": "wrapperGuard.openFinding", "when": "viewItem == wrapperGuardFinding", "group": "inline" },
        { "command": "wrapperGuard.copyEvidence", "when": "viewItem == wrapperGuardFinding", "group": "wrapperGuard@1" }
      ]
    },
    "configuration": {
      "title": "WrapperGuard",
      "properties": {
        "wrapperGuard.cliPath": {
          "type": "string",
          "default": "wrapperguard",
          "description": "Path to the WrapperGuard CLI executable (wrapperguard-cli)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}
