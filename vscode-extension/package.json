{
  "name": "wrapperguard",
  "displayName": "WrapperGuard",
  "description": "Static wrapper and bootstrap security analysis for Gradle projects. Never executes project code.",
  "version": "0.2.0",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Linters", "Programming Languages"],
  "activationEvents": ["onStartupFinished", "onView:wrapperGuard.main", "onCommand:wrapperGuard.scanWorkspace"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "wrapperGuard.scanWorkspace", "title": "WrapperGuard: Scan Workspace", "icon": "$(refresh)" },
      { "command": "wrapperGuard.exportReport", "title": "WrapperGuard: Export Report (JSON)", "icon": "$(export)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "wrapperGuard", "title": "WrapperGuard", "icon": "resources/shield.svg" }
      ]
    },
    "views": {
      "wrapperGuard": [
        { "id": "wrapperGuard.main", "name": "WrapperGuard", "type": "webview" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "wrapperGuard.scanWorkspace", "when": "view == wrapperGuard.main", "group": "navigation@1" },
        { "command": "wrapperGuard.exportReport", "when": "view == wrapperGuard.main", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "WrapperGuard",
      "properties": {
        "wrapperGuard.cliPath": {
          "type": "string",
          "default": "wrapperguard",
          "description": "Path to the WrapperGuard CLI executable (wrapperguard-cli)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}
