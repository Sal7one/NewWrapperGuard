{
  "name": "wrapperguard",
  "displayName": "WrapperGuard",
  "description": "Local security vetting with a built-in static scanner and user-authorized providers.",
  "version": "0.7.0",
  "publisher": "sal7one",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sal7one/NewWrapperGaurd"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:wrapperGuard.main",
    "onCommand:wrapperGuard.scanWorkspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wrapperGuard.scanWorkspace",
        "title": "WrapperGuard: Scan Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "wrapperGuard.exportReport",
        "title": "WrapperGuard: Export Report (JSON)",
        "icon": "$(export)"
      },
      {
        "command": "wrapperGuard.exportSarif",
        "title": "WrapperGuard: Export SARIF",
        "icon": "$(export)"
      },
      {
        "command": "wrapperGuard.evaluate",
        "title": "WrapperGuard: Evaluate Providers"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wrapperGuard",
          "title": "WrapperGuard",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "views": {
      "wrapperGuard": [
        {
          "id": "wrapperGuard.main",
          "name": "WrapperGuard",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "wrapperGuard.scanWorkspace",
          "when": "view == wrapperGuard.main",
          "group": "navigation@1"
        },
        {
          "command": "wrapperGuard.exportReport",
          "when": "view == wrapperGuard.main",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "WrapperGuard",
      "properties": {
        "wrapperGuard.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Run a scan automatically when a workspace folder is opened."
        },
        "wrapperGuard.allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional hosts allowed in URLs and repositories (merged with the built-in defaults).",
          "scope": "application"
        },
        "wrapperGuard.blockedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional commands blocked in wrapper/script files (merged with the built-in defaults).",
          "scope": "application"
        },
        "wrapperGuard.requireDistributionSha256": {
          "type": "boolean",
          "default": false,
          "description": "Require distributionSha256Sum in gradle-wrapper.properties.",
          "scope": "application"
        },
        "wrapperGuard.providerPermissions": {
          "type": "object",
          "scope": "application",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "actions",
              "required",
              "timeoutMs"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 300000
              },
              "actions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "WARNING",
                    "MAJOR_WARNING",
                    "ALERT",
                    "BLOCK_BUILD",
                    "BLOCK_SYNC"
                  ]
                }
              }
            }
          },
          "description": "User-owned grants for each registered provider. Built-in defaults to enabled/all actions; external SDK providers default to disabled/no actions. Workspace overrides are rejected."
        },
        "wrapperGuard.providerConfigPath": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Absolute JSON provider configuration file outside the workspace. Command providers require Workspace Trust and execute only the explicitly configured command."
        },
        "wrapperGuard.methodFlags": {
          "type": "object",
          "scope": "application",
          "default": {},
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Optional security methods from the Tools and Research tabs. User Settings only; changing a flag invalidates previous results. Disabling built-in methods reduces coverage."
        },
        "wrapperGuard.historyEnabled": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Opt in to local per-project scan summaries. No source evidence or messages are stored. History does not change enforcement."
        },
        "wrapperGuard.historyLimit": {
          "type": "integer",
          "scope": "application",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum local history summaries retained for each project. Older owned summaries are removed after the next saved scan."
        },
        "wrapperGuard.automation": {
          "type": "object",
          "scope": "application",
          "default": {
            "schemaVersion": 1,
            "enabled": false,
            "onChanges": true,
            "debounceMs": 2000,
            "intervalMinutes": 0,
            "providers": {}
          },
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "enabled",
            "onChanges",
            "debounceMs",
            "intervalMinutes",
            "providers"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "onChanges": {
              "type": "boolean"
            },
            "debounceMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 60000
            },
            "intervalMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "providers": {
              "type": "object",
              "maxProperties": 33,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "network",
                  "cost",
                  "acknowledged"
                ],
                "properties": {
                  "network": {
                    "enum": [
                      "NONE",
                      "LOCAL",
                      "REMOTE",
                      "UNKNOWN"
                    ]
                  },
                  "cost": {
                    "enum": [
                      "LOW",
                      "METERED",
                      "UNKNOWN"
                    ]
                  },
                  "acknowledged": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "description": "Reviewed automatic SCAN preferences. User Settings only. Saving or enabling leaves the current editor session paused until Review & start in Automation. Network/cost declarations do not sandbox provider code."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/copy-method-catalog.js",
    "watch": "tsc -watch -p ./",
    "parity": "node scripts/parity.js",
    "hardening": "node scripts/hardening.js",
    "test": "npm run compile && node --test tests/*.test.js && npm run check:webview",
    "check:webview": "node scripts/check-webview.js",
    "package": "npm run build:sdk && npm run compile && vsce package --out wrapperguard-0.7.0.vsix",
    "build:sdk": "python3 ../scripts/build-sdk.py --copy-vscode",
    "test:host": "npm run compile && node scripts/test-host.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.7.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Built-in static analysis works without trust. Explicit command providers require a trusted workspace."
    }
  },
  "types": "./dist/extension.d.ts",
  "dependencies": {
    "sax": "1.6.1"
  }
}
