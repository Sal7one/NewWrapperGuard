{
  "apiVersion": 1,
  "builtIn": {
    "enabled": true,
    "actions": ["WARNING", "MAJOR_WARNING", "ALERT", "BLOCK_BUILD", "BLOCK_SYNC"],
    "required": true,
    "timeoutMs": 30000
  },
  "providers": [
    {
      "id": "example.compliance",
      "displayName": "Example compliance adapter",
      "version": "1.0.0",
      "command": ["/absolute/path/to/python3", "/absolute/path/to/example_provider.py"],
      "permissions": {
        "enabled": false,
        "actions": ["WARNING"],
        "required": false,
        "timeoutMs": 30000
      }
    }
  ]
}
