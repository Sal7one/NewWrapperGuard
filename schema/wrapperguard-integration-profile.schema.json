{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrapperguard.dev/schema/integration-profile-v1.json",
  "title": "WrapperGuard controlled integration profile",
  "description": "Explicit user-owned SDK profile stored outside the scanned project. Host action grants remain separate. Path containment and executable checks are enforced at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "version",
    "analysisKind",
    "format"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,79}$",
      "not": {
        "const": "wrapperguard"
      }
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "analysisKind": {
      "enum": [
        "SAST",
        "SCA",
        "DAST",
        "AI"
      ]
    },
    "format": {
      "enum": [
        "sarif",
        "bandit",
        "psscriptanalyzer",
        "trivy",
        "osv",
        "zap",
        "script-semantics",
        "ai-review",
        "cyclonedx",
        "sonar",
        "http-audit",
        "container-python"
      ]
    },
    "reportPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Absolute path to a JSON report selected by the user. No report location is discovered from repository settings."
    },
    "runner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "bandit"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute tool executable: inside the reviewed image when sandbox is selected; otherwise an installed host tool outside the project."
            },
            "sandbox": {
              "$ref": "#/$defs/sandbox"
            }
          },
          "required": [
            "tool",
            "executable"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "psscriptanalyzer"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute user-owned path; runtime enforces containment, symlinks and existence."
            },
            "modulePath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute user-owned path; runtime enforces containment, symlinks and existence."
            }
          },
          "required": [
            "tool",
            "executable",
            "modulePath"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "trivy"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute user-owned path; runtime enforces containment, symlinks and existence."
            },
            "cachePath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute user-owned path; runtime enforces containment, symlinks and existence."
            }
          },
          "required": [
            "tool",
            "executable"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "osv"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute user-owned path; runtime enforces containment, symlinks and existence."
            }
          },
          "required": [
            "tool",
            "executable"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "script-semantics"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          },
          "required": [
            "tool"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "const": "local-ai"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "endpoint": {
              "type": "string",
              "maxLength": 512,
              "description": "Explicit HTTP numeric loopback address, port and /v1 path. Runtime rejects remote hosts, credentials and query strings."
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,159}$"
            },
            "inputReportPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Absolute user-owned path; runtime enforces containment, symlinks and existence."
            },
            "responseFormat": {
              "enum": [
                "json_schema",
                "json_object"
              ],
              "default": "json_schema",
              "description": "Structured JSON schema by default; JSON object mode is an explicit compatibility choice."
            }
          },
          "required": [
            "tool",
            "endpoint",
            "model",
            "inputReportPath"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "executable"
          ],
          "properties": {
            "tool": {
              "const": "semgrep"
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute tool executable: inside the reviewed image when sandbox is selected; otherwise an installed host tool outside the project."
            },
            "rulesPath": {
              "type": "string",
              "minLength": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "rulePacks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "legacy-android-ktor",
                  "android-manifest",
                  "android-webview",
                  "jvm-crypto",
                  "ktor-runtime"
                ]
              },
              "description": "Select bundled local packs. Omission preserves the original Android/Ktor pack."
            },
            "sandbox": {
              "$ref": "#/$defs/sandbox"
            }
          },
          "not": {
            "required": [
              "rulesPath",
              "rulePacks"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "ownershipConfirmed",
            "targetUrls"
          ],
          "properties": {
            "tool": {
              "const": "http-audit"
            },
            "ownershipConfirmed": {
              "const": true
            },
            "targetUrls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uri",
                "maxLength": 8192,
                "pattern": "^https?://"
              },
              "description": "Exact reviewed numeric-IP URLs inside targetScope; runtime rejects DNS, credential URLs and out-of-scope targets. No redirects/crawling."
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000,
              "default": 30000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216,
              "default": 16777216
            },
            "maxRequests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32,
              "default": 16
            },
            "requestTimeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000,
              "default": 5000
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576,
              "default": 262144
            },
            "authHeadersEnv": {
              "type": "object",
              "maxProperties": 8,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
              },
              "description": "Selected authentication header names map to existing environment variable names, never plaintext secret values. Host/hop-by-hop overrides rejected."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "sandbox",
            "entryPath",
            "executionConfirmed"
          ],
          "properties": {
            "tool": {
              "const": "container-python"
            },
            "sandbox": {
              "$ref": "#/$defs/sandbox"
            },
            "executable": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 1024,
              "default": "/usr/local/bin/python",
              "description": "Python executable inside the reviewed immutable image; no host fallback."
            },
            "entryPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\.py$",
              "description": "Normalized project-relative entry selected explicitly; copied Python files only, no traversal/symlinks."
            },
            "executionConfirmed": {
              "const": true
            },
            "executionTimeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000,
              "default": 3000
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000,
              "default": 30000
            },
            "maxOutputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216,
              "default": 16777216
            }
          }
        }
      ]
    },
    "allowedOperations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SCAN",
          "BUILD",
          "SYNC"
        ]
      },
      "default": [
        "SCAN"
      ]
    },
    "requestedActions": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "WARNING",
          "MAJOR_WARNING",
          "ALERT",
          "BLOCK_BUILD",
          "BLOCK_SYNC"
        ]
      },
      "default": [
        "WARNING"
      ],
      "description": "Requests only; the host intersects these actions with separate user grants."
    },
    "targetScope": {
      "$ref": "#/$defs/targetScope"
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Optional absolute project binding. Runtime requires the selected canonical root to match before reading reports or starting tools."
    },
    "reportProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestPath"
      ],
      "properties": {
        "manifestPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Absolute user-owned manifest outside every selected project; exact report/input hashes and age are verified, not producer authenticity."
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800,
          "default": 86400
        }
      }
    },
    "dependencyCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireResolvedVersions": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Optional bounded producer inventory accounting. Required fixed versions fail closed on unknown/unresolved inventory, without running package managers or claiming full transitive coverage."
    }
  },
  "oneOf": [
    {
      "required": [
        "reportPath"
      ],
      "not": {
        "required": [
          "runner"
        ]
      },
      "properties": {
        "format": {
          "enum": [
            "sarif",
            "bandit",
            "psscriptanalyzer",
            "trivy",
            "osv",
            "zap",
            "cyclonedx",
            "sonar"
          ]
        }
      }
    },
    {
      "required": [
        "runner"
      ],
      "not": {
        "required": [
          "reportPath"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "sarif"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "SAST",
              "SCA"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "bandit"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "SAST"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "psscriptanalyzer"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "SAST"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "trivy"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "SCA"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "osv"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "SCA"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "zap"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "DAST"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "script-semantics"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "SAST"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "ai-review"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "enum": [
              "AI"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysisKind": {
            "const": "DAST"
          }
        }
      },
      "then": {
        "required": [
          "targetScope"
        ]
      },
      "else": {
        "not": {
          "required": [
            "targetScope"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "properties": {
              "tool": {
                "const": "bandit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "format": {
            "const": "bandit"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "properties": {
              "tool": {
                "const": "psscriptanalyzer"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "format": {
            "const": "psscriptanalyzer"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "properties": {
              "tool": {
                "const": "trivy"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "format": {
            "const": "trivy"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "properties": {
              "tool": {
                "const": "osv"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "format": {
            "const": "osv"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "properties": {
              "tool": {
                "const": "script-semantics"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "format": {
            "const": "script-semantics"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "properties": {
              "tool": {
                "const": "local-ai"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "format": {
            "const": "ai-review"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "runner"
        ],
        "properties": {
          "runner": {
            "properties": {
              "tool": {
                "const": "semgrep"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "format": {
            "const": "sarif"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "cyclonedx"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "const": "SCA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "sonar"
          }
        }
      },
      "then": {
        "properties": {
          "analysisKind": {
            "const": "SAST"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "http-audit"
          }
        }
      },
      "then": {
        "required": [
          "runner"
        ],
        "properties": {
          "analysisKind": {
            "const": "DAST"
          },
          "runner": {
            "properties": {
              "tool": {
                "const": "http-audit"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reportProvenance"
        ]
      },
      "then": {
        "required": [
          "reportPath"
        ]
      }
    },
    {
      "if": {
        "required": [
          "dependencyCoverage"
        ]
      },
      "then": {
        "properties": {
          "analysisKind": {
            "const": "SCA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "container-python"
          }
        }
      },
      "then": {
        "required": [
          "runner"
        ],
        "properties": {
          "analysisKind": {
            "const": "SAST"
          },
          "runner": {
            "properties": {
              "tool": {
                "const": "container-python"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "executable"
      ],
      "properties": {
        "tool": {
          "const": "bandit"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 30000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216,
          "default": 16777216
        }
      }
    },
    "targetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origins"
      ],
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 4096
          },
          "description": "Exact HTTP(S) origins, including nondefault ports; wildcards, credentials, query strings and fragments are rejected at runtime."
        },
        "pathPrefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          },
          "default": [
            "/"
          ],
          "description": "Path boundaries are checked after URL normalization. A prefix /app does not permit /application."
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "executable",
        "endpoint",
        "image"
      ],
      "properties": {
        "engine": {
          "const": "docker"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Absolute installed Docker CLI outside every project; never a repository command or host fallback."
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Explicit existing local Unix socket, no remote TCP/context/ambient DOCKER_HOST."
        },
        "image": {
          "type": "string",
          "pattern": "^(?:[a-z0-9][a-z0-9._:/-]{0,199}@)?sha256:[0-9a-f]{64}$",
          "description": "Immutable already-installed image ID or repository digest; provider never pulls or builds."
        },
        "allowRootfulDaemon": {
          "type": "boolean",
          "default": false
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048,
          "default": 256
        },
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 1
        },
        "pidsLimit": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128,
          "default": 32
        }
      },
      "description": "Optional locked-down Linux container backend on POSIX hosts. Rootless preferred; Docker daemon/kernel remain trusted. Fixed network-none/cap-drop/nonroot/readonly/timeout policy cannot be weakened by profile fields."
    }
