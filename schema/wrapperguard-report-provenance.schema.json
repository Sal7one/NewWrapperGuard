{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrapperguard.dev/schema/report-provenance-v1.json",
  "title": "WrapperGuard optional upstream report provenance",
  "description": "Exact report and explicitly listed input integrity/freshness. Producer/database/revision metadata are unauthenticated declarations; this is not a signature or whole-project coverage claim. Runtime limits and no-follow source access apply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportSha256",
    "generatedAt",
    "inputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reportSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Unique normalized project-relative path; no traversal, links, backslashes or absolute paths."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "producer": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "database": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "sourceIdentity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
