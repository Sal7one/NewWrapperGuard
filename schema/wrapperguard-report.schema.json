{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrapperguard.dev/schema/report-v1.json",
  "title": "WrapperGuard Scan Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectPath",
    "verdict",
    "policyName",
    "findings",
    "scannedFiles",
    "durationMs",
    "complete",
    "stale",
    "notices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectPath": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "NOT_SCANNED",
        "CLEAN",
        "REVIEW_REQUIRED",
        "EXECUTION_BLOCKED",
        "INCOMPLETE",
        "STALE",
        "FAILED"
      ]
    },
    "policyName": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "ruleId",
          "title",
          "severity",
          "location",
          "policyAction"
        ],
        "properties": {
          "providerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "actions": {
            "$ref": "#/$defs/actions"
          }
        }
      }
    },
    "scannedFiles": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "boolean"
    },
    "stale": {
      "type": "boolean"
    },
    "notices": {
      "type": "array"
    },
    "providerRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "descriptor",
          "permissions",
          "status",
          "durationMs",
          "findingCount"
        ],
        "properties": {
          "descriptor": {
            "$ref": "#/$defs/descriptor"
          },
          "permissions": {
            "$ref": "#/$defs/permissions"
          },
          "status": {
            "enum": [
              "COMPLETED",
              "FAILED",
              "TIMED_OUT",
              "DISABLED"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "findingCount": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "WARNING",
          "MAJOR_WARNING",
          "ALERT",
          "BLOCK_BUILD",
          "BLOCK_SYNC"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "WARNING",
              "MAJOR_WARNING",
              "ALERT",
              "BLOCK_BUILD",
              "BLOCK_SYNC"
            ]
          },
          "default": []
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 30000
        }
      }
    },
    "descriptor": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "version",
        "apiVersion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "apiVersion": {
          "const": 1
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "description": "Suggested: SAST, SUPPLY_CHAIN, DAST, RESEARCH, AI, OTHER. Custom uppercase categories are supported."
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "default": []
        },
        "inputScope": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/inputScope"
            }
          ]
        }
      }
    },
    "inputScope": {
      "type": "object",
      "additionalProperties": false,
      "description": "User-declared freshness inputs; no execution or action grants. Absent scope means unknown, an empty object declares no local inputs. Excluded directories exclude their descendants.",
      "properties": {
        "includes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Relative forward-slash segments; * and ? within a segment, whole-segment ** across directories. No ., .., empty segments, backslashes, character classes, braces, colons or negation."
          },
          "default": []
        },
        "excludes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Relative forward-slash segments; * and ? within a segment, whole-segment ** across directories. No ., .., empty segments, backslashes, character classes, braces, colons or negation."
          },
          "default": []
        },
        "externalFiles": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "default": [],
          "description": "Absolute regular files outside EVERY open project root; explicit user-selected rules/configuration/report/adapter files. Links are rejected; limits apply."
        }
      }
    }
  }
}
