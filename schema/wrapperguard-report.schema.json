{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrapperguard.dev/schema/report-v1.json",
  "title": "WrapperGuard Scan Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectPath",
    "verdict",
    "policyName",
    "findings",
    "scannedFiles",
    "durationMs",
    "complete",
    "stale",
    "notices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectPath": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "NOT_SCANNED",
        "CLEAN",
        "REVIEW_REQUIRED",
        "EXECUTION_BLOCKED",
        "INCOMPLETE",
        "STALE",
        "FAILED"
      ]
    },
    "policyName": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "ruleId",
          "title",
          "severity",
          "location",
          "policyAction"
        ],
        "properties": {
          "providerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "actions": {
            "$ref": "#/$defs/actions"
          }
        }
      }
    },
    "scannedFiles": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "boolean"
    },
    "stale": {
      "type": "boolean"
    },
    "notices": {
      "type": "array"
    },
    "providerRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "descriptor",
          "permissions",
          "status",
          "durationMs",
          "findingCount"
        ],
        "properties": {
          "descriptor": {
            "$ref": "#/$defs/descriptor"
          },
          "permissions": {
            "$ref": "#/$defs/permissions"
          },
          "status": {
            "enum": [
              "COMPLETED",
              "FAILED",
              "TIMED_OUT",
              "DISABLED"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "findingCount": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "WARNING",
          "MAJOR_WARNING",
          "ALERT",
          "BLOCK_BUILD",
          "BLOCK_SYNC"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "WARNING",
              "MAJOR_WARNING",
              "ALERT",
              "BLOCK_BUILD",
              "BLOCK_SYNC"
            ]
          },
          "default": []
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 30000
        }
      }
    },
    "descriptor": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "version",
        "apiVersion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "apiVersion": {
          "const": 1
        }
      }
    }
  }
}
