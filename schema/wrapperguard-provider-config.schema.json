{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrapperguard.dev/schema/provider-config-v1.json",
  "title": "WrapperGuard user provider configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": 1,
      "default": 1
    },
    "builtIn": {
      "$ref": "#/$defs/permissions"
    },
    "providers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "version",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,79}$",
            "not": {
              "const": "wrapperguard"
            }
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 32768
            },
            "description": "First argument must be an absolute executable path. Arguments are literal; no implicit shell."
          },
          "permissions": {
            "$ref": "#/$defs/permissions"
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
            "not": {
              "const": "BUILT_IN"
            },
            "description": "Suggested: SAST, SUPPLY_CHAIN, DAST, RESEARCH, AI, OTHER. Custom uppercase categories are supported."
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          },
          "tags": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "default": []
          },
          "inputScope": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/inputScope"
              }
            ]
          },
          "projectRoots": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "default": [],
            "description": "Explicit absolute project directory bindings, compared canonically before execution. Empty preserves legacy all-project behavior; nonmatching providers are disabled. No action or execution grants are inferred."
          }
        }
      }
    }
  },
  "$defs": {
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "WARNING",
              "MAJOR_WARNING",
              "ALERT",
              "BLOCK_BUILD",
              "BLOCK_SYNC"
            ]
          },
          "default": []
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 30000
        }
      }
    },
    "inputScope": {
      "type": "object",
      "additionalProperties": false,
      "description": "User-declared freshness inputs; no execution or action grants. Absent scope means unknown, an empty object declares no local inputs. Excluded directories exclude their descendants.",
      "properties": {
        "includes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Relative forward-slash segments; * and ? within a segment, whole-segment ** across directories. No ., .., empty segments, backslashes, character classes, braces, colons or negation."
          },
          "default": []
        },
        "excludes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Relative forward-slash segments; * and ? within a segment, whole-segment ** across directories. No ., .., empty segments, backslashes, character classes, braces, colons or negation."
          },
          "default": []
        },
        "externalFiles": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "default": [],
          "description": "Absolute regular files outside EVERY open project root; explicit user-selected rules/configuration/report/adapter files. Links are rejected; limits apply."
        }
      }
    }
  }
}
