{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrapperguard.dev/schema/provider-config-v1.json",
  "title": "WrapperGuard user provider configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": 1,
      "default": 1
    },
    "builtIn": {
      "$ref": "#/$defs/permissions"
    },
    "providers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "version",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,79}$",
            "not": {
              "const": "wrapperguard"
            }
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 32768
            },
            "description": "First argument must be an absolute executable path. Arguments are literal; no implicit shell."
          },
          "permissions": {
            "$ref": "#/$defs/permissions"
          }
        }
      }
    }
  },
  "$defs": {
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "WARNING",
              "MAJOR_WARNING",
              "ALERT",
              "BLOCK_BUILD",
              "BLOCK_SYNC"
            ]
          },
          "default": []
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 30000
        }
      }
    }
  }
}
